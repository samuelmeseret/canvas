{
  "name": "canvas",
  "version": "0.1.0",
  "description": "Real-time collaborative whiteboard built with Next.js, Liveblocks, Tldraw, and Convex.",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/samuelmeseret/canvas#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/samuelmeseret/canvas.git"
  },
  "bugs": {
    "url": "https://github.com/samuelmeseret/canvas/issues"
  },
  "keywords": [
    "collaboration",
    "whiteboard",
    "nextjs",
    "liveblocks",
    "tldraw",
    "convex"
  ],
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "convex:dev": "convex dev",
    "convex:once": "convex dev --once",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@liveblocks/client": "^3.14.1",
    "@liveblocks/core": "^3.14.1",
    "@liveblocks/node": "^3.14.1",
    "@liveblocks/react": "^3.14.1",
    "@liveblocks/react-ui": "^3.14.1",
    "clsx": "^2.1.1",
    "convex": "^1.32.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-error-boundary": "^6.1.1",
    "tldraw": "^4.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
